#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]

(
    default_album_art_path: None,
    show_song_table_header: true,
    draw_borders: true,
    browser_column_widths: [20, 30, 60],
    symbols: (song: "󰎈 ", dir: "󰉋 ", marker: " ", ellipsis: "..."),
    text_color: "#d8dce9",
    tab_bar: (
        enabled: true,
        active_style: (bg: "#36373f", fg: "#d8dce9", modifiers: "Bold"),
        inactive_style: (fg: "#73757f", modifiers: ""),
    ),
    highlighted_item_style: (fg: "#e5dac3", modifiers: "Bold"),
    current_item_style: (fg: "#d6a8b5", bg: "#36373f", modifiers: "Bold"),
    borders_style: (fg: "#73757f", modifiers: "Bold"),
    highlight_border_style: (fg: "#e5dac3"),
    progress_bar: (
        symbols: ["", "", " "],
        track_style: (fg: "#36373f"),
        elapsed_style: (fg: "#73757f"),
        thumb_style: (fg: "#d6a8b5"),
    ),
    scrollbar: (
        symbols: ["", "", "", ""],
        track_style: (fg: "#73757f"),
        ends_style: (fg: "#73757f"),
        thumb_style: (fg: "#e5dac3"),
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Title)),
                (kind: Text(" - ")),
                (kind: Property(Artist)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#d8dce9"),
                highlighted_item_style: (fg: "#a9cdc7", modifiers: "Bold"),
                default: (kind: Property(Filename), style: (fg: "#73757f"),)
            ),
            width: "50%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#73757f"),
                default: (kind: Text("Unknown Artist"), style: (fg: "#73757f"))
            ),
            width: "45%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#e5dac3")),
            width: "10%",
            alignment: Right,
        ),
    ],
    header: (
        rows: [
            (
                left: [
                    (kind: Property(Status(StateV2(playing_label: " ▶",
                    paused_label: " ⏸", stopped_label: " ⏹"))), style: (fg: "#d6a8b5", modifiers: "Bold")),
                ],
                center: [
                    (kind: Property(Song(Title)), style: (fg: "#d8dce9", modifiers: "Bold"),
                        default: (kind: Property(Song(Filename)), style: (fg: "#d8dce9", modifiers: "Bold"))
                    )
                ],
                right: [
                    (kind: Text("Vol: "), style: (fg: "#e5dac3", modifiers: "Bold")),
                    (kind: Property(Status(Volume)), style: (fg: "#e5dac3", modifiers: "Bold")),
                    (kind: Text("% "), style: (fg: "#e5dac3", modifiers: "Bold"))
                ]
            ),
            (
                left: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#d8dce9")),
                    (kind: Text("/"), style: (fg: "#73757f")),
                    (kind: Property(Status(Duration)), style: (fg: "#d8dce9")),
                ],
                center: [
                    (kind: Property(Song(Artist)), style: (fg: "#cdbce1", modifiers: "Bold"),
                        default: (kind: Text("Unknown Artist"), style: (fg: "#d6b5ba", modifiers: "Bold"))
                    ),
                ],
                right: [
                    (
                        kind: Property(Widget(States(
                            active_style: (fg: "#e5dac3", modifiers: "Bold"),
                            separator_style: (fg: "#73757f"))
                        )),
                        style: (fg: "#73757f")
                    ),
                ]
            ),
        ],
    ),
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            pane: Split(
                                direction: Vertical,
                                panes: [
                                    (
                                        size: "4",
                                        borders: "ALL",
                                        pane: Pane(Header),
                                    ),
                                ]
                            )
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                pane: Pane(Tabs),
            ),
            (
                size: "100%",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "100%",
                            borders: "NONE",
                            pane: Pane(TabContent),
                        ),
                    ]
                ),
            ),
            (
                size: "3",
                borders: "TOP | BOTTOM",
                pane: Pane(ProgressBar),
            ),
        ],
    ),
)
