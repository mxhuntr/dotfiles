# By default Reload config with shft + cmd + ,

config-file = themes/immortal
language = ru
# theme = Black Metal (Immortal)
background-opacity = 0.85
background-blur-radius = 0
image-storage-limit = 320000000

# font-family = Maple Mono Medium
# font-style-bold = Maple Mono Bold
# font-thicken
# font-thicken-strength = 150
# adjust-cell-height = 20%
# font-size = 16

# font-family = Fira Code Semibold
# font-style-bold = Fira Code Bold
# font-thicken
# font-thicken-strength = 0
# adjust-cell-height = 20%
# font-size = 15.8

font-family = Agave Nerd Font
font-style-bold = Agave Nerd Font
font-thicken
font-thicken-strength = 255
font-size = 17.9
adjust-cell-height = 50%
adjust-cell-width = 0%
adjust-underline-thickness = 10%
adjust-strikethrough-thickness = 10%
adjust-overline-thickness = 10%
adjust-cursor-thickness = 100%

cursor-style = block
cursor-style-blink = true
# cursor-invert-fg-bg = true

macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-hide-while-typing = true

confirm-close-surface = false
window-decoration = true
window-padding-x = 10
window-padding-y = 5
window-padding-balance = true

auto-update = off
auto-update-channel = tip

# extras
shell-integration-features = no-cursor
copy-on-select = clipboard
macos-icon = custom
macos-custom-icon = /Users/m/.config/ghostty/icons/ghostty-white.icns
# macos-icon-frame = plastic

# Quick Terminal
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-animation-duration = 0.2
quick-terminal-size = 90%,86%
gtk-quick-terminal-layer = overlay
quick-terminal-autohide = false

# Custom Keybinds & Config (super represents cmd key on mac)
# For Simple Keybinds
keybind = super+n=new_window
keybind = super+o=toggle_quick_terminal
keybind = super+k=close_surface
keybind = super+r=reload_config
keybind = super+i=inspector:toggle

